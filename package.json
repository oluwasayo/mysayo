{
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "knip": "6.45.1",
    "npm-check-updates": "23.1.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "name": "mysayo-monorepo",
  "overrides": {
    "@babel/core": {
      "@babel/generator": "8.1.0",
      "@babel/helper-string-parser": "8.0.8",
      "@babel/helpers": "8.1.0",
      "@babel/parser": "8.1.0",
      "@babel/template": "8.0.0",
      "@babel/traverse": "8.1.0",
      "@babel/types": "8.1.0"
    },
    "astro": {
      "es-module-lexer": "3.0.4"
    },
    "fast-xml-builder": "1.3.1",
    "fast-xml-parser": "5.12.0",
    "mdast-util-to-hast": "13.2.1",
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.1.7",
    "satori": {
      "fflate": "0.7.5"
    }
  },
  "private": true,
  "scripts": {
    "bump-deps": "ncu -u --removeRange --cooldown 5 --cwd code/app/server && ncu -u --removeRange --cooldown 5 --cwd code/app/shared && ncu -u --removeRange --cooldown 5 --cwd code/app/web && ncu -u --removeRange --cooldown 5 --cwd code/doc && ncu -u --removeRange --cooldown 5 --cwd code/bin && ncu -u --removeRange --cooldown 5",
    "clean": "npm run clean --workspaces --if-present",
    "deploy:web": "npm run deploy -w web",
    "dev": "npm run dev:web",
    "dev:web": "npm run dev:web -w web",
    "filter-terraform-plan": "npm run filter-terraform-plan -w bin --",
    "fix": "npm run fix --workspaces --if-present && npm run knip && terraform -chdir=infrastructure fmt -recursive",
    "fix:bin": "npm run fix -w bin && npm run knip",
    "fix:doc": "npm run fix -w doc && npm run knip",
    "fix:server": "npm run fix -w server && npm run knip",
    "fix:shared": "npm run fix -w shared && npm run knip",
    "fix:web": "npm run fix -w web && npm run knip",
    "knip": "knip",
    "lint": "npm run lint --workspaces --if-present",
    "lint:bin": "npm run lint -w bin",
    "lint:doc": "npm run lint -w doc",
    "lint:server": "npm run lint -w server",
    "lint:shared": "npm run lint -w shared",
    "lint:web": "npm run lint -w web",
    "rasterize": "npm run rasterize -w web --",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:shared": "vitest run --project shared",
    "test:web": "vitest run --project web"
  },
  "type": "module",
  "workspaces": [
    "code/app/*",
    "code/bin",
    "code/doc"
  ]
}
